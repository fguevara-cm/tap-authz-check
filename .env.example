# Local environment for tap-authz-check.
# NEVER commit a real .env file. Only .env.example is tracked.
#
# Authentication: this tool no longer uses a Bearer JWT directly. It exchanges a
# Stitch ``session_token`` against the TAP API and uses the resulting session
# cookies (``TAP_SESSION_JWT``, ``TAP_REFRESH_TOKEN``, ``XSRF-TOKEN``) for all
# subsequent calls. The exchange is centralised in ``src/tap_authz_check/session.py``.
#
# Recommended workflow:
#   1. cp .env.example .env
#   2. fill TAP_AUTHZ_SESSION_TOKEN via a shell-managed secret (1Password, Vault, etc.)
#      NEVER paste a real session_token, JWT or cookie into a chat, ticket, commit or backup.
#   3. The bare alias ``SESSION_TOKEN`` is also accepted for ergonomics.
#   4. ``TAP_AUTHZ_ADMIN_SESSION_TOKEN`` enables the positive-control path via
#      ``--force-admin-token`` / ``--compare-admin``.

TAP_AUTHZ_BASE_URL=https://api.tap.mirror.capmotion.io
TAP_AUTHZ_SESSION_TOKEN=
TAP_AUTHZ_ADMIN_SESSION_TOKEN=
TAP_AUTHZ_FIXTURE_FILE=fixtures/mirror.yaml
TAP_AUTHZ_TIMEOUT_SECONDS=30
TAP_AUTHZ_MODE=audit
TAP_AUTHZ_DELAY_MS=100
